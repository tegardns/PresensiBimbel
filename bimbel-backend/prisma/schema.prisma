generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         Role
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLogin    DateTime?
  tutor        Tutor?
}

model Tutor {
  id          String       @id @default(uuid())
  userId      String?      @unique
  alamat      String?
  email       String?
  nama        String?
  namaBank    String?
  noRek       String?
  noWa        String?
  posisi      String?
  status      Boolean      @default(true)
  kode        String       @unique
  fotoUrl     String?
  createdAt   DateTime     @default(now())
  attendances Attendance[]
  user        User?        @relation(fields: [userId], references: [id])
  students    Student[]    @relation("TutorStudents")
}

model Level {
  id            String    @id @default(uuid())
  name          String
  code          String    @unique
  durasiMenit   Int
  hargaJual     Int
  potonganAdmin Int
  students      Student[]
  subjects      Subject[]
}

model Student {
  id          String       @id @default(uuid())
  fullName    String
  levelId     String
  parentName  String?
  parentPhone String?
  isActive    Boolean      @default(true)
  address     String?
  schoolName  String?
  createdAt   DateTime     @default(now())
  kode        String       @unique
  updatedAt   DateTime     @updatedAt
  attendances Attendance[]
  level       Level        @relation(fields: [levelId], references: [id])
  tutors      Tutor[]      @relation("TutorStudents")
}

model Attendance {
  id          String           @id @default(uuid())
  tutorId     String
  studentId   String
  subjectName String
  durationMin Int
  photoUrl    String
  notes       String?
  feeNet      Int
  status      AttendanceStatus @default(tertunda)
  payoutId    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  student     Student          @relation(fields: [studentId], references: [id])
  tutor       Tutor            @relation(fields: [tutorId], references: [id])
}

model Finance {
  id        String   @id @default(uuid())
  tutorId   String
  amount    Int
  type      String
  note      String?
  createdAt DateTime @default(now())
}

model Subject {
  id       String  @id @default(uuid())
  name     String
  isActive Boolean @default(true)
  code     String  @unique
  levelId  String
  level    Level   @relation(fields: [levelId], references: [id])
}

model SystemSetting {
  id          String  @id @default("system")
  namaBimbel  String  @default("BimbelMelly Pusat")
  whatsapp    String  @default("+62 812-3456-7890")
  alamat      String  @default("Jl. Pendidikan No. 123, Jakarta Selatan 12345")
  logoUrl     String?
  komisiAdmin Float   @default(10)
  infoPayout  String  @default("Transfer dilakukan setiap hari Minggu pukul 18:00 WIB. Pastikan data rekening Anda sudah lengkap dan benar.")
  maintenance Boolean @default(false)
}

enum Role {
  admin
  tutor
}

enum AttendanceStatus {
  diselesaikan
  tertunda
  disetujui
  ditolak
  selesai
}
